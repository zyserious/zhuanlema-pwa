# 复制为 .env 并填入你自己的值：cp .env.example .env
# docker compose 会自动读取同目录下的 .env

# 账号（登录用，请改成强密码）
ACCOUNT_USER=demo
ACCOUNT_PASS=demo

# VAPID 密钥：Web Push 的身份标识
# 生成方式（任选其一）：
#   npx web-push generate-vapid-keys
#   python -c "from cryptography.hazmat.primitives.asymmetric import ec; import base64, os; k=ec.generate_private_key(ec.SECP256R1()); print('PUBLIC', base64.urlsafe_b64encode(k.public_key().public_numbers().encode_point()).decode()); print('PRIVATE', base64.urlsafe_b64encode(k.private_numbers().private_value.to_bytes(32,'big')).decode())"
# PUBLIC 是 65 字节非压缩公钥的 base64url；PRIVATE_RAW 是 32 字节原始标量的 base64url
VAPID_PUBLIC=
VAPID_PRIVATE_RAW=

# 推送身份（浏览器会展示这个邮箱）
VAPID_SUBJECT=mailto:you@example.com
